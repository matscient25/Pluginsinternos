# Variaveis de ambiente do plugin notas-fiscais.
# COPIE para um arquivo .env LOCAL (fora do git) e preencha. NUNCA comite valores reais.
#
# Conta Azul (API v2 / OAuth2)
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
# refresh_token obtido 1x no fluxo de autorizacao (ver scripts/README.md)
CONTAAZUL_REFRESH_TOKEN=
# opcional: caminho do cache de token (default ~/.scient/contaazul_token.json)
# CONTAAZUL_TOKEN_CACHE=~/.scient/contaazul_token.json

# Pagar.me (consulta)
PAGARME_SECRET_KEY=
